# Contract the dashboard reads and sends transfers on (any ERC-20)
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Chain to connect to. Defaults to the local anvil/foundry chain.
# Supported: foundry | sepolia | mainnet
NEXT_PUBLIC_CHAIN=foundry

# Optional: your own RPC (Alchemy, Infura, a local node). Falls back to the chain's public RPC.
NEXT_PUBLIC_RPC_URL=
